{
  "name": "eclipse-launcher",
  "version": "1.1.5",
  "author": "Eclipse",
  "description": "Eclipse Game Launcher",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build && electron-builder --win"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.1",
    "discord-rpc": "^4.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.412.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.5",
    "webtorrent": "^3.0.21",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.11",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webtorrent": "^0.110.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.eclipse.launcher",
    "productName": "Eclipse Launcher",
    "artifactName": "Eclipse.Launcher.Setup.${version}.exe",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PE4CE1",
        "repo": "EclipseLauncher"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/eclipselauncher.png"
    },
    "squirrelWindows": {
      "iconUrl": "https://raw.githubusercontent.com/electron/electron/main/default_app/icon.ico",
      "loadingGif": "build/loading.gif"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
